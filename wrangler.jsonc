{
  // Worker + static site. The site lives in ./public; /api/* goes to src/worker.js.
  // Study progress is stored in a Durable Object (SQLite) that Cloudflare creates
  // on deploy, so there is nothing to set up in the dashboard.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jsynapson",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "PROGRESS", "class_name": "ProgressStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProgressStore"] }]
}
